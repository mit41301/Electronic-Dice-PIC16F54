0060 0004           00209 Delay02         clrwdt                          ; reset watchdog timer
0061 02EC           00210                 decfsz  Fine_Delay,F            ; this loop takes approx 10mSec
0062 0A60           00211                 goto    Delay02                 ; (300kHz/2/4/256)
0063 02EB           00212                 decfsz  Coarse_Delay,F
0064 0A5E           00213                 goto    Delay01
0065 0800           00214                 retlw   0
                    00215 
                    00216 ;-----------------------------------------------------------------------------
                    00217 ; Flash segments sequentially to simulate dice rolling.
                    00218     
0066 0C02           00219 Roll            movlw   H'02'                   ; set up for two rolls
0067 0028           00220                 movwf   Temp1
0068 0C08           00221                 movlw   H'08'                   ; set up segement delay
0069 0027           00222                 movwf   Temp
                    00223 
006A 0CF7           00224 Roll00          movlw   B'11110111'             ; Switch display Two ON
006B 0025           00225                 movwf   PORTA
006C 0C02           00226                 movlw   B'00000010'             ; select segment "a"
006D 0026           00227                 movwf   PORTB                   ; write pattern to port B
006E 0207           00228                 movf    Temp,W                  ; wait a while
006F 095D           00229                 call    Delay
0070 0C01           00230                 movlw   B'00000001'             ; "b"
0071 0026           00231                 movwf   PORTB
0072 0207           00232                 movf    Temp,W
0073 095D           00233                 call    Delay
0074 0C20           00234                 movlw   B'00100000'             ; "c"
0075 0026           00235                 movwf   PORTB
0076 0207           00236                 movf    Temp,W
0077 095D           00237                 call    Delay
0078 0C40           00238                 movlw   B'01000000'             ; "d"
0079 0026           00239                 movwf   PORTB
007A 0207           00240                 movf    Temp,W
007B 095D           00241                 call    Delay
                    00242 
007C 0CFB           00243                 movlw   B'11111011'             ; Switch display One ON
007D 0025           00244                 movwf   PORTA
007E 0C40           00245                 movlw   B'01000000'             ; "d" again
007F 0026           00246                 movwf   PORTB
0080 0207           00247                 movf    Temp,W
0081 095D           00248                 call    Delay
0082 0C80           00249                 movlw   B'10000000'             ; "e"
0083 0026           00250                 movwf   PORTB
0084 0207           00251                 movf    Temp,W
0085 095D           00252                 call    Delay
0086 0C04           00253                 movlw   B'00000100'             ; "f"
0087 0026           00254                 movwf   PORTB
0088 0207           00255                 movf    Temp,W
0089 095D           00256                 call    Delay
008A 0C02           00257                 movlw   B'00000010'             ; back to "a"
008B 0026           00258                 movwf   PORTB
008C 0207           00259                 movf    Temp,W
008D 095D           00260                 call    Delay
                    00261 
