                    00103 
                    00104 
001B 0004           00105 Main            clrwdt                          ; clear watchdog timer
001C 09A7           00106                 call    Random                  ; update random number
001D 0992           00107                 call    Flash                   ; flash the decimal point
001E 0705           00108                 btfss   PORTA,0                 ; is the button pressed?
001F 0A22           00109                 goto    Main02                  ; yes
0020 0070           00110                 clrf    ButtonFlag              ;  no, clear flag
0021 0A1B           00111                 goto    Main                    ;  and loop back.
                    00112 
0022 0610           00113 Main02          btfsc   ButtonFlag,0            ; is button stuck down?
0023 0A1B           00114                 goto    Main                    ; yes, loop back
0024 0510           00115                 bsf     ButtonFlag,0            ; no, but now set flag
                    00116 
                    00117 ; Get two random numbers
                    00118 
0025 0212           00119                 movf    Random_1,W              ; get first random number
0026 0034           00120                 movwf   Hold_1                  ; and save it
0027 0992           00121 Main03          call    Flash                   ; flash the decimal point
0028 09AE           00122                 call    Rand02                  ; continue updating 2nd number
0029 0705           00123                 btfss   PORTA,0                 ; is the button released?
002A 0A27           00124                 goto    Main03                  ;  no, wait for it.
002B 0213           00125                 movf    Random_2,W              ; get second random number
002C 0035           00126                 movwf   Hold_2                  ; and save it too
                    00127 
002D 0966           00128                 call    Roll                    ; roll the dice
                    00129 
002E 0C32           00130                 movlw   D'50'                   ; reset sleep counter
002F 0031           00131                 movwf   Sleep_Count
0030 0CFF           00132                 movlw   H'FF'                   ; set up display time
0031 0029           00133                 movwf   Displ_Pause
                    00134 
0032 0C20           00135                 movlw   H'20'                   ; pause
0033 095D           00136                 call    Delay
                    00137 
                    00138 ; Display left digit by itself for a sec or so
                    00139 
0034 0004           00140 Output          clrwdt                          ; reset watchdog timer
0035 0CFB           00141                 movlw   B'11111011'             ; Switch display One ON
0036 0025           00142                 movwf   PORTA
0037 0214           00143                 movf    Hold_1,W                ; get the first random number
0038 094D           00144                 call    Display
                    00145                 
0039 02E9           00146                 decfsz  Displ_Pause,F           ; has timing loop finished?
003A 0A34           00147                 goto    Output                  ;   no, do it all again.
                    00148                 
                    00149 ; now display both digits
                    00150 
003B 0CFF           00151                 movlw   H'FF'                   ; set up display time
003C 0029           00152                 movwf   Displ_Pause
003D 0004           00153 Out01           clrwdt                          ; reset watchdog timer
003E 0CFB           00154                 movlw   B'11111011'             ; Switch display One ON
003F 0025           00155                 movwf   PORTA
