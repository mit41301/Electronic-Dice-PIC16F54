008E 02E8           00262                 decfsz  Temp1,F                 ; is this the last roll?
008F 0A6A           00263                 goto    Roll00                  ;  no, go agound again
0090 0066           00264                 clrf    PORTB                   ;  yes, switch off LEDs
0091 0800           00265                 retlw   0
                    00266 
                    00267 ;--------------------------------------------------------------------------
                    00268 ; Decimal Point Flash routine. Used to show that PIC is "awake".
                    00269 ; If the button hasn't been pressed for fifty flashes, the processor goes
                    00270 ; to sleep to conserve power.
                    00271 
0092 02EE           00272 Flash           decfsz   Flash_Low,F            ; has low timer run out?
0093 0800           00273                 retlw   0                       ;   no, return
0094 0CFF           00274                 movlw   H'FF'                   ;   yes, reset timer
0095 002E           00275                 movwf   Flash_Low
0096 02EF           00276                 decfsz  Flash_High,F            ; has high timer run out?
0097 0800           00277                 retlw   0                       ;   no, return
0098 0C1F           00278                 movlw   H'1F'                   ;   yes, reset timer
0099 002F           00279                 movwf   Flash_High
009A 0CFB           00280                 movlw   B'11111011'             ; Switch display One ON
009B 0025           00281                 movwf   PORTA
009C 0C10           00282                 movlw   B'00010000'             ; set up bit pattern for dec point
009D 0026           00283                 movwf   PORTB                   ; write it out
009E 0C05           00284                 movlw   H'05'
009F 095D           00285                 call    Delay                   ; and pause a bit
00A0 0066           00286                 clrf    PORTB                   ; switch it off again
                    00287 
                    00288 ; is it sleepy time yet?
                    00289 
00A1 02F1           00290                 decfsz  Sleep_Count,F           ; has count expired?
00A2 0800           00291                 retlw   0                       ; no.
                    00292 
00A3 0CFF           00293                 movlw   H'FF'                   ; yes, shut down all ports
00A4 0005           00294                 tris    PORTA                   ; (make them inputs
00A5 0006           00295                 tris    PORTB                   ;       to conserve power)
00A6 0003           00296                 sleep                           ; and goto sleep!
                    00297                 
                    00298 ;----------------------------------------------------------------------------
                    00299 ; Random number generator: We constantly decrement two numbers to use as the
                    00300 ; seed for the dice roll. As this happens about 4000 times per second
                    00301 ; it is impossible to guess which number will be present when the
                    00302 ; button is pressed (for display 1) and released (for display 2).
                    00303 
00A7 02F2           00304 Random          decfsz  Random_1,F              ; has it got to zero?
00A8 0AAC           00305                 goto    Rand01                  ;    no, skip it
00A9 0C06           00306                 movlw   H'06'                   ;    yes, reset it to 6
00AA 0032           00307                 movwf   Random_1
00AB 0AAE           00308                 goto    Rand02
                    00309 
00AC 0000           00310 Rand01          nop                             ; add some delays so that we spend equal time
00AD 0000           00311                 nop                             ;   in branch, to make roll truly random.
                    00312 
                    00313 ; now do 2nd Number
                    00314 
MPASM 01.21 Released            DICE2.ASM   7-25-1995  11:43:47         PAGE  7


LOC  OBJECT CODE     LINE SOURCE TEXT
  VALUE

00AE 02F3           00315 Rand02          decfsz  Random_2,F              ; has it got to zero?
00AF 0AB3           00316                 goto    Rand03                  ;    no, skip it
00B0 0C06           00317                 movlw   H'06'                   ;    yes, reset it to 6
00B1 0033           00318                 movwf   Random_2
00B2 0800           00319                 retlw   0                       ; return
                    00320 
00B3 0000           00321 Rand03          nop                             ; add some more delays
00B4 0000           00322                 nop
00B5 0800           00323                 retlw   0                       ; return
                    00324 
                    00325 ; ---------------------------------------------------------------------------
                    00326 ; Look-up tables for display bit patterns: These use a "computed goto" technique.
                    00327 ; The value in "W" is added to the program counter to cause program execution
                    00328 ; to jump to the appropriate line. The "Return-with-Literal-in-W" instruction
                    00329 ; returns the required value.
                    00330 
00B6 01E2           00331 Look_Up_Seg     addwf   PCL,F        ; return bit pattern for sucessive segments
00B7 0000           00332                 nop                  ;     (we skip the "zero" value)
                    00333 
                    00334 
00B8 0802           00335                 retlw   B'00000010'             ;  a
00B9 0801           00336                 retlw   B'00000001'             ;  b
00BA 0820           00337                 retlw   B'00100000'             ;  c
00BB 0840           00338                 retlw   B'01000000'             ;  d
00BC 0880           00339                 retlw   B'10000000'             ;  e
00BD 0804           00340                 retlw   B'00000100'             ;  f
00BE 0808           00341                 retlw   B'00001000'             ;  g
                    00342 
                    00343 
                    00344 ; ------------------------------------------------------------------------
                    00345 
00BF 01E2           00346 Look_Up_Digit   addwf   PCL,F        ; return bit patterns for each digit (from 1 -> 6)
00C0 0000           00347                 nop                  ;    (we skip the "zero" digit)
                    00348 
                    00349                                         ;                 a
00C1 0821           00350                 retlw  B'00100001'      ; '1'          xxxxxxx
00C2 08CB           00351                 retlw  B'11001011'      ; '2'      f  x       x b
00C3 086B           00352                 retlw  B'01101011'      ; '3'         x   g   x
00C4 082D           00353                 retlw  B'00101101'      ; '4'           xxxxxx
00C5 086E           00354                 retlw  B'01101110'      ; '5'      e  x       x c
00C6 08EE           00355                 retlw  B'11101110'      ; '6'         x       x
                    00356                                         ;               xxxxxx
                    00357                                         ;                  d
                    00358                                         ;
                    00359                                         ; bits         76543210
                    00360                                         ; segments     edcXgfab    (X = dec point)
                    00361 
                    00362 ; ------------------------------------------------------------------------
                    00363  END
