                    00018 ; -------------------------------------------------------------------------
                    00019 ; Inputs and Outputs:
                    00020 ;       Port A
                    00021 ;               RA0 - Input  - push button to start Dice Roll
                    00022 ;               RA1 - Input  - unused
                    00023 ;               RA2 - Output  - Drive to left  LED display
                    00024 ;               RA3 - Output  - Drive to right LED display
                    00025 ;        Port B
                    00026 ;               RB0 - Output - drives segment "b" of LED display
                    00027 ;               RB1 - Output - drives segment "a"
                    00028 ;               RB2 - Output - drives segment "f"
                    00029 ;               RB3 - Output - drives segment "g"
                    00030 ;               RB4 - Output - drives segment "dec. point"
                    00031 ;               RB5 - Output - drives segment "c"
                    00032 ;               RB6 - Output - drives segment "d"
                    00033 ;               RB7 - Output - drives segment "e"
                    00034 
                    00035 ; define data registers in RAM
                    00036 
0007                00037                 org     H'07'                   ; spare user RAM begins at 07h
                    00038 
0007                00039 Temp            res     1                       ; misc storage
0008                00040 Temp1           res     1                       ; misc storage
0009                00041 Displ_Pause     res     1                       ; counter for delay between flashes
000A                00042 Segment         res     1                       ; pointer to next segment
000B                00043 Coarse_Delay    res     1                       ; used by general delay routine
000C                00044 Fine_Delay      res     1                       ;   ,,   ,,    ,,    ,,   ,,
000D                00045 Seg_Count       res     1
000E                00046 Flash_Low       res     1                       ; used by Flash delay
000F                00047 Flash_High      res     1                       ;   ,,    ,,   ,,
0010                00048 ButtonFlag      res     1                       ; "stuck button" flag
                    00049 
0011                00050 Sleep_Count     res     1                       ; used by sleep delay
