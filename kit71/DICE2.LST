0040 0214           00156                 movf    Hold_1,W                ; get the first random number
0041 094D           00157                 call    Display
                    00158                 
                    00159 ; Now display Right Digit
                    00160 
0042 0CF7           00161                 movlw   B'11110111'             ; Switch display Two ON
0043 0025           00162                 movwf   PORTA
0044 0215           00163                 movf    Hold_2,W                ; get the 2nd random number
0045 094D           00164                 call    Display
                    00165 
0046 02E9           00166                 decfsz  Displ_Pause,F           ; has timing loop finished?
0047 0A3D           00167                 goto    Out01                   ;   no, do it all again.
                    00168                 
0048 0CFF           00169                 movlw   H'FF'                   ; restart flash timer
0049 002E           00170                 movwf   Flash_Low
004A 0C1F           00171                 movlw   H'1F'
004B 002F           00172                 movwf   Flash_High
004C 0A1B           00173                 goto    Main                    ; and go back to beginning
                    00174 
                    00175 ;--------------------------------------------------------
                    00176 ; Display digits: As each LED display has only one (common) dropping resistor,
                    00177 ; we must "Multiplex" the pattern on to each display, one segment at
                    00178 ; a time. The eye smooths all this into seeing complete digits.
                    00179 ; Enter with number to be displayed in "W"
                    00180 
004D 09BF           00181 Display         call    Look_Up_Digit           ; go get digit pattern
004E 0027           00182                 movwf   Temp                    ; save it
                    00183                 
004F 0C07           00184 Disp01          movlw   H'07'                   ; set up for seven segments
0050 002A           00185                 movwf   Segment
                    00186 
0051 020A           00187 Disp03          movf    Segment,W               ; get next segment pattern
0052 09B6           00188                 call    Look_Up_Seg
0053 0147           00189                 andwf   Temp,W                  ; mask out this segment
0054 0026           00190                 movwf   PORTB                   ;   and display it
                    00191 
0055 0C0F           00192                 movlw   H'0F'                   ; set up for a delay
0056 002C           00193                 movwf   Fine_Delay              ; so we can see the segment illuminated
0057 02EC           00194 Disp04          decfsz  Fine_Delay,F            ; is the delay finished?
0058 0A57           00195                 goto    Disp04
                    00196 
0059 02EA           00197                 decfsz  Segment,F               ; is this the last segment?
005A 0A51           00198                 goto    Disp03                  ;   no, do it again.
                    00199 
005B 0066           00200                 clrf    PORTB                   ; clear display
005C 0800           00201                 retlw   0
                    00202 
                    00203 ;--------------------------------------------------------
                    00204 ; General purpose Delay routine: Feed multiples of 10mS in via "W" reg
                    00205 
005D 002B           00206 Delay           movwf   Coarse_Delay
005E 0CFF           00207 Delay01         movlw   H'FF'
005F 002C           00208                 movwf   Fine_Delay
MPASM 01.21 Released            DICE2.ASM   7-25-1995  11:43:47         PAGE  5


