0012                00051 Random_1        res     1                       ; A number between 1 and six for dice roll
0013                00052 Random_2        res     1
0014                00053 Hold_1          res     1                       ; temp store for random number
0015                00054 Hold_2          res     1
                    00055 
                    00056 ; define Reset Vector
                    00057 
01FF                00058                 org     H'1FF'                  ; power-on-reset lands here
01FF 0A00           00059                 goto    Start                   ; and jumps to start of program
                    00060 
0000                00061                 org     H'00'                   ; Start code at bottom of EPROM
                    00062 
                    00063 ; first we check if this is a wakeup call (eg. were we in sleep mode previously?)
                    00064 
0000 0663           00065 Start           btfsc   STATUS,NOT_PD           ; check Power Down bit in status register (1=watchdog, 0=p
                          ower reset)
0001 0A08           00066                 goto    Start02                 ; ok, it was a normal power up
                    00067 
0002 0705           00068                 btfss   PORTA,0                 ; it was a wake-up call, so is the push button pressed?
0003 0A06           00069                 goto    Start01                 ; yes, check if it's stuck
0004 0070           00070                 clrf    ButtonFlag              ; no, clear "button stuck" flag
0005 0003           00071                 sleep                           ; and go back to sleep again.
                    00072 
0006 0610           00073 Start01         btfsc   ButtonFlag,0            ; is button stuck down?
0007 0003           00074                 sleep                           ; yes, go back to sleep again.
                    00075 
                    00076 ; next we initialise everything:
                    00077                                                 ; watch dog timer is set to wake PIC from sleep
                    00078                                                 ; approx once every second
0008 0C0F           00079 Start02         movlw   B'00001111'             ; watch dog runs via prescaler, set to divide by 256
0009 0002           00080                 option                          ; write this to Option reg.
000A 0004           00081                 clrwdt                          ; reset watchdog timer.
                    00082 
000B 0CF3           00083                 movlw   B'11110011'             ; RA2 & RA3 are output while RA0 reads push button
000C 0005           00084                 tris    PORTA
000D 0CFF           00085                 movlw   B'11111111'             ; Switch all Port A lines high
000E 0025           00086                 movwf   PORTA
                    00087 
000F 0C00           00088                 movlw   B'00000000'             ; switch all of Port B to outputs (to drive the LEDs)
0010 0006           00089                 tris    PORTB
0011 0C00           00090                 movlw   B'00000000'             ; Switch all Port_B lines low
0012 0026           00091                 movwf   PORTB                   ; (so that all the display LEDs are off)
                    00092 
0013 0C01           00093                 movlw   H'01'                   ; initialise various registers
0014 002F           00094                 movwf   Flash_High
0015 002E           00095                 movwf   Flash_Low
0016 0C32           00096                 movlw   D'50'
0017 0031           00097                 movwf   Sleep_Count
0018 0C06           00098                 movlw   H'06'
0019 0032           00099                 movwf   Random_1
001A 0510           00100                 bsf     ButtonFlag,0            ; start with button flag set
                    00101 
                    00102 ; Main Program Loop
