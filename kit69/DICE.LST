                     0014  
                     0015         include "p16c5x.inc"           ; pic fuse setting header 
                     0002 ; P16C5X.INC  Standard Header File, Version 0.1     Microchip Technology, Inc. 
                     0015  
  0FFF               0016      __FUSES _CP_OFF & _WDT_ON & _RC_OSC 
                     0017  
                     0018 ; ------------------------------------------------------------------------- 
                     0019 ; The Fuse settings in your Programmer should be set to: 
                     0020 ; 
                     0021 ;                       Watchdog timer     => ON 
                     0022 ;                       Osc Start up timer => ON 
                     0023 ;                       Code protect       => OFF 
                     0024 ;                       Osc type           => RC 
                     0025 ;         
                     0026 ; ------------------------------------------------------------------------- 
                     0027 ; Inputs and Outputs: 
                     0028 ;       Port A 
                     0029 ;               RA0 - Input  - push button to start Dice Roll 
                     0030 ;               RA1 - Input  - unused 
                     0031 ;               RA2 - Input  - unused 
                     0032 ;               RA3 - Input  - unused 
                     0033 ;        Port B 
                     0034 ;               RB0 - Output - drives segment "b" of LED display 
                     0035 ;               RB1 - Output - drives segment "a" 
                     0036 ;               RB2 - Output - drives segment "f" 
                     0037 ;               RB3 - Output - drives segment "g" 
                     0038 ;               RB4 - Output - drives segment "dec. point" 
                     0039 ;               RB5 - Output - drives segment "c" 
                     0040 ;               RB6 - Output - drives segment "d" 
                     0041 ;               RB7 - Output - drives segment "e" 
                     0042  
                     0043 ; define data registers in RAM 
                     0044  
                     0045                 org     H'07'                   ; spare 16c54 RAM begins at 07h 
                     0046  
  0001               0047 Temp            res     1                       ; misc storage 
  0001               0048 Temp1           res     1                       ; misc storage 
  0001               0049 Displ_Pause     res     1                       ; counter for segment hold pause 
  0001               0050 Segment         res     1                       ; pointer to next segment 
  0001               0051 Coarse_Delay    res     1                       ; used by general delay routine 
