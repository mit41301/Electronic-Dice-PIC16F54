  VALUE

0083 0000            0264                 nop                  ;    (we skip the "zero" digit) 
                     0265  
                     0266                                         ;                 a 
0084 0821            0267                 retlw  B'00100001'      ; '1'          xxxxxxx 
0085 08CB            0268                 retlw  B'11001011'      ; '2'      f  x       x b 
0086 086B            0269                 retlw  B'01101011'      ; '3'         x   g   x 
0087 082D            0270                 retlw  B'00101101'      ; '4'           xxxxxx 
0088 086E            0271                 retlw  B'01101110'      ; '5'      e  x       x c 
0089 08EE            0272                 retlw  B'11101110'      ; '6'         x       x 
                     0273                                         ;               xxxxxx 
                     0274                                         ;                  d 
                     0275                                         ; 
                     0276                                         ; bits         76543210 
                     0277                                         ; segments     edcXgfab    (X = dec point) 
                     0278  
                     0279 ; ------------------------------------------------------------------------ 
